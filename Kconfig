# Build-time options for RvKernel Manager.
#
# Every entry below declares one option together with its default.
# Values are chosen in .config; options absent from .config fall back
# to their declared default here.

mainmenu "RvKernel Manager"

choice
	prompt "C compiler"
	default CC_GCC

config CC_GCC
	bool "Build with GCC"
	help
	  Compile the whole tree with gcc.

config CC_CLANG
	bool "Build with Clang"
	help
	  Compile the whole tree with clang instead of gcc.

endchoice

config DEBUG
	bool "Diagnostic logging"
	default y
	help
	  Emit timestamped application messages on stderr: startup and
	  privilege handling, sysfs and procfs access, page construction,
	  refresh ticks, and every setting that gets applied.
	  Disable for a silent build with zero logging overhead.
